{
  "manifest_version": 3,
  "name": "Fact Check — verify claims locally",
  "version": "0.1.0",
  "description": "Select any claim on the web and check it against real sources in one click — runs on your own machine, no cloud, no paid API, nothing you type ever leaves your computer.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fact Check",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
